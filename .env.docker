# Docker Compose Environment Variables
# Copy to .env and modify for your setup

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=dmr
DB_PORT=5432

# Node Environment
NODE_ENV=production

# API Configuration
API_PORT=3000
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long

# Frontend URLs
FRONTEND_URL=http://localhost
ADMIN_URL=http://localhost

# Web Configuration
WEB_PORT=80
VITE_API_URL=http://localhost:3000
VITE_TELEGRAM_BOT_USERNAME=

# Optional: Translation Providers (choose one)
GEMINI_API_KEY=
GROQ_API_KEY=
TRANSLATE_PROVIDER=

# Optional: Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRestaurantRole {
  OWNER
  EDITOR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Language {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(10)
  name      String?
  sortOrder Int      @default(0)
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(200)
  slug      String?  @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains      RestaurantDomain[]
  userLinks    UserRestaurant[]
  menus        Menu[]
  siteSettings SiteSettings?
  bookings     Booking[]
}

model RestaurantDomain {
  id           String     @id @default(cuid())
  host         String     @unique @db.VarChar(255)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model UserRestaurant {
  id           String              @id @default(cuid())
  userId       String
  restaurantId String
  role         UserRestaurantRole  @default(EDITOR)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  name         String     @db.VarChar(120)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuTypes  MenuType[]

  @@index([restaurantId])
}

model MenuType {
  id        String   @id @default(cuid())
  menuId    String
  code      String   @db.VarChar(30)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  imagePath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  translations MenuTypeTranslation[]
  categories   Category[]

  @@unique([menuId, code])
}

model MenuTypeTranslation {
  id         String   @id @default(cuid())
  menuTypeId String
  locale     String   @db.VarChar(10)
  name       String
  menuType   MenuType @relation(fields: [menuTypeId], references: [id], onDelete: Cascade)

  @@unique([menuTypeId, locale])
}

model Category {
  id         String   @id @default(cuid())
  menuTypeId String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  imagePath  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuType     MenuType              @relation(fields: [menuTypeId], references: [id], onDelete: Cascade)
  translations CategoryTranslation[]
  menuItems    MenuItem[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String   @db.VarChar(10)
  name        String
  description String?
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model MenuItem {
  id             String   @id @default(cuid())
  categoryId     String
  price          Decimal  @db.Decimal(10, 2)
  weightOrVolume String?  @db.VarChar(50)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  imagePath      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations MenuItemTranslation[]
}

model MenuItemTranslation {
  id          String   @id @default(cuid())
  menuItemId  String
  locale      String   @db.VarChar(10)
  name        String
  description String?
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurants UserRestaurant[]
}

model SiteSettings {
  id                   String   @id @default(cuid())
  restaurantId         String   @unique
  logoPath             String?
  footerText           String?  @db.Text
  siteName             String?
  contactText          String?  @db.Text
  ownerTelegramChatId  String?  @db.VarChar(64)
  staffTelegramChatId  String?  @db.VarChar(64)
  updatedAt            DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Booking {
  id             String        @id @default(cuid())
  restaurantId   String
  orderNumber    String        @db.VarChar(32)
  guestName      String        @db.VarChar(200)
  phone          String        @db.VarChar(50)
  email          String?       @db.VarChar(200)
  scheduledAt    DateTime?
  partySize      Int           @default(1)
  comment        String?       @db.Text
  status         BookingStatus @default(PENDING)
  itemsJson      Json?
  receiptText    String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, createdAt])
}
